#!/bin/zsh
# Flashcat - a local AI assistant in the terminal (named after Flash the cat). Runs a local model through LM Studio
# (default: Gemma 4 26B) or Ollama and can work with files in the current folder.
# Usage: flashcat [options] ["question"]   (with a question: answers once and exits; input can be piped in)
# Options: --continue / -c (continue the last chat in this folder), --model / -m <name> (other model, part of the
#          name is enough), --models (list installed models), --backend [lmstudio|ollama] (choose the model
#          server when both are installed), --update (install the newest release), --version, --help.
#          Type /help inside the chat for commands.
# Loads the model if needed. When the last Flashcat window ends (normally or by closing the window), flashcat-cleanup
# unloads it again and stops what Flashcat started (server, LM Studio background service, Ollama), freeing the RAM.
HERE=${0:A:h}  # the folder with flashcat-chat.py and flashcat-cleanup (~/.local/bin, or Homebrew's folder)
CHAT=$HERE/flashcat-chat.py
CLEANUP=$HERE/flashcat-cleanup
REPO=TomTomsen765/flashcat
LMS=~/.lmstudio/bin/lms
STATE=~/.flashcat/active
BACKEND_FILE=~/.flashcat/backend  # the model server chosen when both are installed
SERVICE_PATTERN="/Contents/MacOS/(LM Studio|Bionic) --run-as-service"  # LM Studio is called Bionic in newer versions
LMS_MODEL=gemma-4-26b-a4b-it-qat
LMS_MODEL_URL=https://huggingface.co/lmstudio-community/gemma-4-26B-A4B-it-QAT-GGUF
LMS_MODEL_DIR=~/.lmstudio/models/lmstudio-community/gemma-4-26B-A4B-it-QAT-GGUF
OLLAMA_MODEL=gemma4:26b
OLLAMA_SHARED=gemma4-26b-lmstudio:latest  # Ollama's name for LM Studio's download of the default model

usage() {
  cat <<EOF
Flashcat $(/usr/bin/python3 $CHAT --version | cut -d' ' -f2) – a local AI assistant for your terminal

  flashcat                    chat in the current folder
  flashcat "question"         answer once and exit
  cat log.txt | flashcat "what went wrong?"
                              answer about piped input (the answer alone goes to a file or pipe)

  -c, --continue              continue the last chat in this folder
  -m, --model <name>          use another model (part of the name is enough)
      --models                list the installed models
      --backend [name]        choose LM Studio or Ollama (asks without a name)
      --update                install the newest release
      --version               show the version

Settings: FLASHCAT_BACKEND=lmstudio|ollama, FLASHCAT_CONTEXT=<tokens>, FLASHCAT_AUTOCOMPACT=<0–0.95>,
          FLASHCAT_API_KEY=<key>
Inside the chat, /help lists the commands.
EOF
}

case $1 in
  --help|-h) usage; exit 0 ;;
  --version|-V) /usr/bin/python3 $CHAT --version; exit ;;
esac

if [[ $1 == --update ]]; then
  if [[ $HERE == */Cellar/* ]]; then
    echo "Flashcat was installed with Homebrew – update it with:  brew upgrade flashcat"
    exit 0
  fi
  # the newest release (not the development state on main): runs that release's installer, which replaces
  # Flashcat's files and keeps chats and the downloaded model
  fetch=(curl --proto '=https' --tlsv1.2 -fsSL)  # https only, also when a download is redirected
  tag=$($fetch https://api.github.com/repos/$REPO/releases/latest 2>/dev/null \
        | /usr/bin/python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"])' 2>/dev/null)
  if [[ -z $tag ]]; then
    echo "Update failed: GitHub could not be reached. Check the internet connection and try again." >&2
    exit 1
  fi
  version_name='^v[0-9]+(\.[0-9]+)*$'  # the name becomes part of a download address
  if [[ ! $tag =~ $version_name ]]; then
    echo "Update failed: GitHub returned an unexpected version name. Nothing was changed." >&2
    exit 1
  fi
  current=$(/usr/bin/python3 $CHAT --version | cut -d' ' -f2)
  if [[ ${tag#v} == $current && ${FLASHCAT_FORCE_UPDATE:-} != 1 ]]; then
    echo "Flashcat $current is the newest version."
    exit 0
  fi
  echo "Updating Flashcat $current → ${tag#v} …"
  installer=$($fetch https://raw.githubusercontent.com/$REPO/$tag/install.sh) || {
    echo "Update failed: the installer could not be downloaded. Try again later." >&2
    exit 1
  }
  FLASHCAT_REF=$tag exec /bin/bash -c "$installer"
fi

has_lmstudio() { [[ -x $LMS ]] }
has_ollama() { (( $+commands[ollama] )) }
# the default model already downloaded? (checked in the model folders: asking the apps would start them)
lmstudio_has_model() { local files=($LMS_MODEL_DIR/*.gguf(N)); (( $#files )) }
ollama_has_model() {
  local m
  for m in $OLLAMA_MODEL $OLLAMA_SHARED; do
    [[ -f ${OLLAMA_MODELS:-~/.ollama/models}/manifests/registry.ollama.ai/library/${m%%:*}/${m#*:} ]] && return 0
  done
  return 1
}

# Ollama can run the model files LM Studio downloaded. They are cloned into Ollama's store first (an APFS clone
# needs no extra disk space); where that is not possible, Ollama copies them itself. Prints "shared" or "copied".
share_lmstudio_model() {
  local store=${OLLAMA_MODELS:-~/.ollama/models} modelfile file blob how=shared
  modelfile=$(mktemp)
  mkdir -p $store/blobs 2>/dev/null
  for file in $LMS_MODEL_DIR/*.gguf(N); do
    blob=$store/blobs/sha256-$(shasum -a 256 $file | cut -d' ' -f1)
    [[ -f $blob ]] || cp -c $file $blob 2>/dev/null || how=copied
    print -r -- "FROM \"$file\"" >> $modelfile
  done
  ollama create $OLLAMA_SHARED -f $modelfile >/dev/null 2>&1 || { rm -f $modelfile; return 1; }
  rm -f $modelfile
  print -r -- $how
}

choose_backend() {  # asks which model server to use and saves the answer; prints the choice
  local l_model="not downloaded yet (15.6 GB)" o_model="not downloaded yet (about 18 GB)" default=1 answer
  lmstudio_has_model && l_model="Gemma 4 downloaded ✓"
  if ollama_has_model; then o_model="Gemma 4 downloaded ✓"
  elif lmstudio_has_model; then o_model="can use LM Studio's download of Gemma 4"; fi
  if ! lmstudio_has_model && ollama_has_model; then default=2; fi
  {
    echo "Flashcat can use LM Studio or Ollama – both are installed."
    echo "  1  LM Studio   $l_model"
    echo "  2  Ollama      $o_model"
  } >&2
  answer=""
  [[ -r /dev/tty ]] && read -r "answer?Which one? [1/2, Enter = $default] " </dev/tty 2>/dev/tty
  case ${answer:-$default} in
    1|l*|L*) answer=lmstudio ;;
    2|o*|O*) answer=ollama ;;
    *) echo "Please answer 1 or 2." >&2; return 1 ;;
  esac
  mkdir -p ~/.flashcat && print -r -- $answer > $BACKEND_FILE
  echo "Using ${${answer:s/lmstudio/LM Studio}:s/ollama/Ollama} from now on. Change it with: flashcat --backend" >&2
  print -r -- $answer
}

if [[ $1 == --backend ]]; then
  case ${2:-} in
    "")
      if has_lmstudio && has_ollama; then choose_backend >/dev/null; exit
      else echo "Only one model server is installed – nothing to choose." >&2; exit 0; fi ;;
    lmstudio|ollama)
      if [[ $2 == lmstudio ]] && ! has_lmstudio; then echo "LM Studio is not installed: https://lmstudio.ai/download" >&2; exit 1; fi
      if [[ $2 == ollama ]] && ! has_ollama; then echo "Ollama is not installed: https://ollama.com" >&2; exit 1; fi
      mkdir -p ~/.flashcat && print -r -- $2 > $BACKEND_FILE
      echo "Flashcat uses ${${2:s/lmstudio/LM Studio}:s/ollama/Ollama} from now on." >&2
      exit 0 ;;
    *) echo "flashcat --backend lmstudio | ollama (or without a name to choose)" >&2; exit 2 ;;
  esac
fi

for arg in "$@"; do
  if [[ $arg == -* && $arg != (-c|--continue|-m|--model|--models) ]]; then
    echo "Unknown option: $arg" >&2
    echo "flashcat --help shows all options." >&2
    exit 2
  fi
done

# which model server: FLASHCAT_BACKEND, else the saved choice, else the one that is installed - if both are,
# Flashcat asks once (in a terminal) and remembers the answer
BACKEND=${FLASHCAT_BACKEND:-}
if [[ -z $BACKEND ]]; then
  saved=""
  [[ -f $BACKEND_FILE ]] && saved=$(<$BACKEND_FILE)
  if { [[ $saved == lmstudio ]] && has_lmstudio } || { [[ $saved == ollama ]] && has_ollama }; then BACKEND=$saved
  elif has_lmstudio && has_ollama; then
    if [[ -r /dev/tty ]] && [[ -t 0 || -t 2 ]]; then BACKEND=$(choose_backend) || exit 2
    else BACKEND=lmstudio; fi  # no terminal to ask in: the default
  elif has_lmstudio; then BACKEND=lmstudio
  elif has_ollama; then BACKEND=ollama
  else
    echo "No model server found. Install LM Studio (https://lmstudio.ai/download) or Ollama (https://ollama.com)," >&2
    echo "open it once, then start flashcat again." >&2
    exit 1
  fi
fi
case $BACKEND in
  lmstudio) [[ -x $LMS ]] || { echo "LM Studio was not found ($LMS). Install it from https://lmstudio.ai/download" >&2; exit 1; }
            MODEL=$LMS_MODEL ;;
  ollama)   (( $+commands[ollama] )) || { echo "Ollama was not found. Install it from https://ollama.com" >&2; exit 1; }
            MODEL=$OLLAMA_MODEL ;;
  *)        echo "FLASHCAT_BACKEND must be lmstudio or ollama." >&2; exit 2 ;;
esac
export FLASHCAT_BACKEND=$BACKEND
if [[ $BACKEND == ollama ]]; then
  OLLAMA_PORT=${${OLLAMA_HOST:-127.0.0.1:11434}##*:}
  [[ $OLLAMA_PORT == <-> ]] || OLLAMA_PORT=11434
fi

# in very broad folders (home, /, …) ask before anything is loaded
if [[ $1 != --models ]]; then
  /usr/bin/python3 $CHAT --confirm-folder >&2 || exit 0
  export FLASHCAT_FOLDER_CONFIRMED=1
fi

mkdir -p $STATE
touch $STATE/session.$$
trap 'exit 129' HUP TERM

# ---------- start the model server if needed (the cleanup stops what was started here) ----------
if [[ $BACKEND == lmstudio ]]; then
  # Was LM Studio running before? (checked before the first lms call, which starts its background service)
  if ! pgrep -f "$SERVICE_PATTERN" >/dev/null && ! pgrep -xq "LM Studio|Bionic"; then
    touch $STATE/service
  fi
elif ! ollama list >/dev/null 2>&1; then
  ollama serve >~/.flashcat/ollama.log 2>&1 &
  print -r -- $! > $STATE/ollama-server
  for i in {1..50}; do ollama list >/dev/null 2>&1 && break; sleep 0.2; done
fi

installed_models() {
  if [[ $BACKEND == lmstudio ]]; then
    $LMS ls --llm --json 2>/dev/null | /usr/bin/python3 -c 'import json, sys; print("\n".join(m["modelKey"] for m in json.load(sys.stdin)))'
  else
    ollama list 2>/dev/null | awk 'NR > 1 && $1 !~ /^flashcat-/ {print $1}'
  fi
}

if [[ $1 == --models ]]; then
  if [[ $BACKEND == lmstudio ]]; then $LMS ls --llm 2>/dev/null; else ollama list 2>/dev/null | grep -v '^flashcat-'; fi
  $CLEANUP $$
  exit
fi
if [[ $1 == --model || $1 == -m ]]; then
  [[ -n $2 ]] || { echo "Which model? List them with: flashcat --models" >&2; $CLEANUP $$; exit 1; }
  MODEL=$(installed_models | /usr/bin/python3 -c '
import sys
want = sys.argv[1].lower()
keys = [k for k in sys.stdin.read().split() if k]
hits = [k for k in keys if k.lower() == want] or [k for k in keys if want in k.lower()]
print(hits[0] if len(hits) == 1 else "")
sys.exit(0 if len(hits) == 1 else 1)' "$2") || {
    echo "No unique model matches '$2'. Installed models:" >&2
    installed_models >&2
    $CLEANUP $$
    exit 1
  }
  shift 2
fi

# Ollama without its own Gemma 4: use LM Studio's download if there is one
if [[ $BACKEND == ollama && $MODEL == $OLLAMA_MODEL ]] && ! installed_models | grep -qx -- "$MODEL"; then
  if installed_models | grep -qx -- "$OLLAMA_SHARED"; then
    MODEL=$OLLAMA_SHARED
  elif lmstudio_has_model; then
    echo "Gemma 4 is not in Ollama yet, but LM Studio has already downloaded it." >&2
    answer=""
    [[ -r /dev/tty ]] && read -r "answer?  Use LM Studio's files with Ollama (no download)? [Y/N] " </dev/tty 2>/dev/tty
    if [[ $answer == [yY]* ]]; then
      echo "Preparing the model for Ollama (takes about a minute) …" >&2
      if how=$(share_lmstudio_model); then
        MODEL=$OLLAMA_SHARED
        if [[ $how == shared ]]; then echo "Done – both use the same data, no extra disk space." >&2
        else echo "Done – Ollama keeps its own copy (15.6 GB more on disk)." >&2; fi
      else
        echo "That did not work." >&2
      fi
    fi
  fi
fi

# the default model is missing (e.g. installed with Homebrew): offer the download
if ! installed_models | grep -qx -- "$MODEL"; then
  if [[ $BACKEND == lmstudio ]]; then
    size="15.6 GB"; hint="$LMS get $LMS_MODEL_URL"; get=($LMS get $LMS_MODEL_URL -y)
  else
    size="about 18 GB"; hint="ollama pull $MODEL"; get=(ollama pull $MODEL)
  fi
  echo "The model $MODEL is not downloaded yet ($size)." >&2
  answer=""
  [[ -r /dev/tty ]] && read -r "answer?  Download it now? [Y/N] " </dev/tty 2>/dev/tty
  if [[ $answer != [yY]* ]]; then
    echo "Download it later with:  $hint" >&2
    $CLEANUP $$
    exit 1
  fi
  $get >&2 || { echo "The download failed." >&2; $CLEANUP $$; exit 1; }
fi

# Watchdog in its own session: runs the cleanup even if the terminal window is closed and every process of
# the window gets killed. On a normal exit this script stops the watchdog and runs the cleanup itself.
/usr/bin/python3 -c '
import os, signal, subprocess, sys, time
os.setsid()
signal.signal(signal.SIGHUP, signal.SIG_IGN)
parent = int(sys.argv[1])
while True:
    try:
        os.kill(parent, 0)
    except ProcessLookupError:
        break
    time.sleep(1)
subprocess.run([sys.argv[2], str(parent)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
' $$ $CLEANUP </dev/null >/dev/null 2>&1 &
watchdog_pid=$!

# context window: 64k on Macs with 24 GB or more, 16k below (can be set with FLASHCAT_CONTEXT)
if [[ -z ${FLASHCAT_CONTEXT:-} ]]; then
  if (( $(sysctl -n hw.memsize) >= 24 * 1073741824 )); then FLASHCAT_CONTEXT=65536; else FLASHCAT_CONTEXT=16384; fi
fi
export FLASHCAT_CONTEXT FLASHCAT_MODEL_NAME=$MODEL

if [[ $BACKEND == lmstudio ]]; then
  if ! $LMS server status 2>&1 | grep -q "is running"; then
    $LMS server start >/dev/null 2>&1 || { $CLEANUP $$; exit 1; }
    touch $STATE/server
  fi
  # the port LM Studio's server uses (1234 unless changed in LM Studio)
  export FLASHCAT_PORT=$($LMS server status --json 2>/dev/null | /usr/bin/python3 -c \
    'import json, sys; print(json.load(sys.stdin).get("port") or 1234)' 2>/dev/null || echo 1234)
  if ! $LMS ps 2>/dev/null | grep -q "^$MODEL "; then
    echo "Loading $MODEL …" >&2
    if ! $LMS load $MODEL --context-length $FLASHCAT_CONTEXT --parallel 1 -y >/dev/null 2>&1; then
      echo "Loading failed." >&2
      kill $watchdog_pid 2>/dev/null
      $CLEANUP $$
      exit 1
    fi
    grep -qx "$MODEL" $STATE/loaded 2>/dev/null || print -r -- "$MODEL" >> $STATE/loaded
  fi
else
  export FLASHCAT_PORT=$OLLAMA_PORT
  # Ollama's OpenAI interface has no context setting, so Flashcat uses a copy of the model with its context size
  # (a few lines of settings - the model file itself is shared, not copied)
  RUN_MODEL="flashcat-${MODEL//[^a-zA-Z0-9._-]/-}-$(( FLASHCAT_CONTEXT / 1024 ))k"
  if ! ollama show $RUN_MODEL >/dev/null 2>&1; then
    modelfile=$(mktemp)
    printf 'FROM %s\nPARAMETER num_ctx %s\n' $MODEL $FLASHCAT_CONTEXT > $modelfile
    ollama create $RUN_MODEL -f $modelfile >/dev/null 2>&1 || { echo "Preparing $MODEL failed." >&2; rm -f $modelfile; kill $watchdog_pid 2>/dev/null; $CLEANUP $$; exit 1; }
    rm -f $modelfile
  fi
  if ! ollama ps 2>/dev/null | grep -q "^$RUN_MODEL "; then
    echo "Loading $MODEL …" >&2
    if ! curl -fsS -m 600 http://127.0.0.1:$OLLAMA_PORT/api/generate -d "{\"model\": \"$RUN_MODEL\", \"keep_alive\": -1}" >/dev/null 2>&1; then
      echo "Loading failed." >&2
      kill $watchdog_pid 2>/dev/null
      $CLEANUP $$
      exit 1
    fi
    grep -qx "$RUN_MODEL" $STATE/ollama-loaded 2>/dev/null || print -r -- "$RUN_MODEL" >> $STATE/ollama-loaded
  fi
  MODEL=$RUN_MODEL
fi

/usr/bin/python3 $CHAT $MODEL "$@"
code=$?

kill $watchdog_pid 2>/dev/null
$CLEANUP -v $$
exit $code
